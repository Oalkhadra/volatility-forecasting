    "import pandas as pd\n",
    "\n",
    "# Load the data\n",
    "df = pd.read_parquet('../data/processed/spy_options.parquet')\n",
    "\n",
    "# Check unique dates\n",
    "unique_dates = df['date'].unique()\n",
    "print(f\"Number of unique dates: {len(unique_dates)}\")\n",
    "print(f\"\\nFirst 10 dates:\")\n",
    "print(sorted(unique_dates)[:10])"
